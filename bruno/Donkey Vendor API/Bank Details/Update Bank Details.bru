meta {
  name: Update Bank Details
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/vendor/bank-details/update
  body: multipart-form
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Accept: application/json
}

body:multipart-form {
  bank_account_number: 918273645019
  ifsc_code: SBIN0001234
  account_type: Current
  bankstatement: @file(/path/to/bank_statement.pdf)
}

docs {
  Update bank account details and upload bank statement file.
}
