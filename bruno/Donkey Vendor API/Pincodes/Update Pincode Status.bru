meta {
  name: Update Pincode Status
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/vendor/pincodes/:pincode_id/status
  body: json
  auth: bearer
}

params:path {
  pincode_id: 1
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
{
  "status": "active"
}
}

docs {
  Update the status ("active" or "inactive") of a specific pincode belonging to vendor.
  Supported status values: "active", "inactive".
}
