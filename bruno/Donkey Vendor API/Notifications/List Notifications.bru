meta {
  name: List Notifications
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/vendor/notifications?category=All&per_page=15
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Accept: application/json
}

docs {
  List only global/system and authenticated-vendor notifications. Supported category values: All, Payments, Riders, Bookings, System.
}
