meta {
  name: List Documents
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/vendor/documents
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Accept: application/json
}

docs {
  Get URLs of all uploaded vendor verification documents (Aadhaar, PAN, Bank Statement, QR, Video).
}
