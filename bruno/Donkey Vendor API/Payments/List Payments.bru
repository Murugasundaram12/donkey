meta {
  name: List Payments
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/vendor/payments
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Accept: application/json
}

docs {
  List vendor subscription payment plans and payment history.
  Note: This endpoint is exempt from payment expiration blocking so expired vendors can view plans and initiate subscription renewal.
}
