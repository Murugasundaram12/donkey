meta {
  name: Update Service Status
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/api/vendor/services/:service_id/status
  body: json
  auth: bearer
}

params:path {
  service_id: 1
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
{
  "status": "active"
}
}

docs {
  Update the status ("active" or "inactive") of a specific service for the authenticated vendor.
  Supported status values: "active", "inactive".
}
