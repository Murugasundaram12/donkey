meta {
  name: Active Coupons
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/vendor/coupons/active
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Accept: application/json
}

docs {
  Get active coupons visible to the authenticated vendor.
  Results include the vendor's own coupons, eligible admin global coupons,
  and eligible admin pincode coupons.
}
