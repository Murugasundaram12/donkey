meta {
  name: Get Dashboard
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/vendor/dashboard
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Accept: application/json
}

docs {
  Fetch vendor dashboard metrics (booking totals, earnings, online/offline riders, active coupons).
}
