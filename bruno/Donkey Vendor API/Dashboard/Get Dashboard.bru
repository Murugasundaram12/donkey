meta {
  name: Get Dashboard
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/vendor/dashboard
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Accept: application/json
}

docs {
  Fetch vendor dashboard metrics.
  Response structure:
  - bookings_summary: total, today, incomplete, completed, cancelled
  - earnings_summary: total, today, this_month
  - riders_summary: total, online, offline, pending_approval
  - active_coupons_count: count of active vendor coupons
  - notifications_count: count of unread notifications
  - services_summary: total_services, active_services
  
  HTTP Status Codes:
  - 200 OK: Valid vendor payment and authenticated
  - 403 Forbidden: Vendor payment expired ("Your subscription/payment has expired. Please renew your payment.")
}
